# Shared
APP_NAME=Performly
APP_ENV=local

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://performly:performly@localhost:5432/performly
SYNC_DATABASE_URL=postgresql://performly:performly@localhost:5432/performly
SESSION_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Resend
RESEND_API_KEY=
EMAIL_FROM=Performly <noreply@example.com>

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Performly
